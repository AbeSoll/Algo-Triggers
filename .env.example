# Copy to .env. The app loads this file on startup. Never commit .env.

# Set your alert inbox locally. Keep real addresses in .env only.
ALERT_TO=

# Gmail: turn on 2-step verification, create an App Password, paste it as SMTP_PASS.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
