{
  "name": "algo-triggers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "format:check": "prettier --check src tests index.html vite.config.ts playwright.config.ts scripts",
    "format": "prettier --write src tests index.html vite.config.ts playwright.config.ts scripts",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node server/index.mjs",
    "test:e2e": "playwright test",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
